# ── Django Core ──────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-strong-secret-key-here

# Set to False in production
DEBUG=False

# Your Railway domain, e.g. fambudget-backend.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1,your-railway-domain.up.railway.app

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
