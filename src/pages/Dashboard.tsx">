import { useExpenses } from '../context/ExpenseContext'
import { Calendar, ChevronDown, CreditCard, Target } from 'lucide-react'
import { motion } from 'framer-motion'
import { useMemo } from 'react'

const categoryIcons: Record<string, string> = {
  Food: '🍔', Transport: '🚗', Entertainment: '🎬', Utilities: '💡',
  Shopping: '🛍️', Healthcare: '🏥', Education: '📚', Other: '📌',
}

const categoryColors: Record<string, { bg: string; text: string }> = {
  Food: { bg: 'bg-orange-500', text: 'text-orange-500' },
  Transport: { bg: 'bg-blue-500', text: 'text-blue-500' },
  Entertainment: { bg: 'bg-purple-500', text: 'text-purple-500' },
  Utilities: { bg: 'bg-yellow-500', text: 'text-yellow-500' },
  Shopping: { bg: 'bg-pink-500', text: 'text-pink-500' },
  Healthcare: { bg: 'bg-green-500', text: 'text-green-500' },
  Education: { bg: 'bg-indigo-500', text: 'text-indigo-500' },
  Other: { bg: 'bg-gray-500', text: 'text-gray-500' },
}

export default function Dashboard() {
  const { expenses, income, cards, goals } = useExpenses()

  const stats = useMemo(() => {
    const now = new Date()
    const thisMonth = now.getMonth()
    const thisYear = now.getFullYear()

    const monthlyIncome = income.filter(i => {
      const d = new Date(i.date)
      return d.getMonth() === thisMonth && d.getFullYear() === thisYear
    })
    const totalIncome = monthlyIncome.reduce((sum, i) => sum + i.amount, 0)

    const monthlyExpenses = expenses.filter(e => {
      const d = new Date(e.date)
      return d.getMonth() === thisMonth && d.getFullYear() === thisYear
    })
    const totalSpent = monthlyExpenses.reduce((sum, e) => sum + e.amount, 0)

    const categoryBreakdown: Record<string, number> = {}
    monthlyExpenses.forEach(e => {
      categoryBreakdown[e.category] = (categoryBreakdown[e.category] || 0) + e.amount
    })

    const categoryPercentages = Object.entries(categoryBreakdown).map(([category, amount]) => ({
      category,
      amount,
      percentage: totalSpent > 0 ? (amount / totalSpent) * 100 : 0
    })).sort((a, b) => b.amount - a.amount)

    const last7Days = []
    for (let i = 6; i >= 0; i--) {
      const date = new Date(now)
      date.setDate(date.getDate() - i)
      date.setHours(0, 0, 0, 0)
      
      const dayIncome = income
        .filter(inc => new Date(inc.date).toDateString() === date.toDateString())
        .reduce((sum, inc) => sum + inc.amount, 0)
      
      const dayExpense = expenses
        .filter(exp => new Date(exp.date).toDateString() === date.toDateString())
        .reduce((sum, exp) => sum + exp.amount, 0)

      last7Days.push({
        day: date.toLocaleDateString('en-US', { weekday: 'short' }),
        income: dayIncome,
        expense: dayExpense,
        date: date
      })
    }

    return { totalIncome, totalSpent, categoryPercentages, last7Days }
  }, [expenses, income])

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-2xl font-bold text-text dark:text-dark-text">Overview</h2>
          <p className="text-sm text-text-muted dark:text-dark-text-muted mt-1">
            Today is {new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
        </div>
        <div className="flex items-center gap-2 bg-surface dark:bg-dark-surface px-4 py-2 rounded-lg border border-border dark:border-dark-border shadow-sm">
          <Calendar className="w-4 h-4 text-text-muted dark:text-dark-text-muted" />
          <span className="text-sm text-text dark:text-dark-text">Jul 2 - Today 2022</span>
          <ChevronDown className="w-4 h-4 text-text-muted dark:text-dark-text-muted" />
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-4 gap-4">
        <div className="lg:col-span-3 space-y-4">
          <div className="grid grid-cols-2 gap-4">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              className="bg-surface dark:bg-dark-surface rounded-xl p-4 border border-border dark:border-dark-border shadow-sm"
            >
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-xs font-semibold text-text-muted dark:text-dark-text-muted">Total Income</h3>
                <button className="text-xs text-primary dark:text-blue-400 flex items-center gap-1 hover:text-primary-dark">
                  All accounts <ChevronDown className="w-3 h-3" />
                </button>
              </div>
              
              <div className="relative w-28 h-28 mx-auto mb-3">
                <svg className="w-full h-full -rotate-90" viewBox="0 0 100 100">
                  <circle
                    cx="50"
                    cy="50"
                    r="40"
                    fill="none"
                    stroke="#f0f0f0"
                    strokeWidth="12"
                    className="dark:stroke-gray-700"
                  />
                  {income.length > 0 && (
                    <>
                      <circle
                        cx="50"
                        cy="50"
                        r="40"
                        fill="none"
                        stroke="#007AFF"
                        strokeWidth="12"
                        strokeDasharray={`${(stats.totalIncome / (stats.totalIncome + stats.totalSpent || 1)) * 251.2} 251.2`}
                        strokeLinecap="round"
                      />
                      <circle
                        cx="50"
                        cy="50"
                        r="40"
                        fill="none"
                        stroke="#34C759"
                        strokeWidth="12"
                        strokeDasharray={`0 ${(stats.totalIncome / (stats.totalIncome + stats.totalSpent || 1)) * 251.2} ${((stats.totalIncome * 0.6) / (stats.totalIncome + stats.totalSpent || 1)) * 251.2} 251.2`}
                        strokeLinecap="round"
                      />
                      <circle
                        cx="50"
                        cy="50"
                        r="40"
                        fill="none"
                        stroke="#FF9500"
                        strokeWidth="12"
                        strokeDasharray={`0 ${((stats.totalIncome * 1.6) / (stats.totalIncome + stats.totalSpent || 1)) * 251.2} ${((stats.totalIncome * 0.4) / (stats.totalIncome + stats.totalSpent || 1)) * 251.2} 251.2`}
                        strokeLinecap="round"
                      />
                    </>
                  )}
                </svg>
                <div className="absolute inset-0 flex items-center justify-center">
                  <div className="text-center">
                    <div className="text-lg font-bold text-text dark:text-dark-text">
                      ${stats.totalIncome.toLocaleString()}
                    </div>
                  </div>
                </div>
              </div>

              <div className="space-y-1">
                <div className="flex items-center justify-between text-[10px]">
                  <div className="flex items-center gap-2">
                    <div className="w-1.5 h-1.5 rounded-full bg-primary"></div>
                    <span className="text-text-muted dark:text-dark-text-muted">Salary</span>
                  </div>
                </div>
                <div className="flex items-center justify-between text-[10px]">
                  <div className="flex items-center gap-2">
                    <div className="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                    <span className="text-text-muted dark:text-dark-text-muted">Savings</span>
                  </div>
                </div>
                <div className="flex items-center justify-between text-[10px]">
                  <div className="flex items-center gap-2">
                    <div className="w-1.5 h-1.5 rounded-full bg-accent"></div>
                    <span className="text-text-muted dark:text-dark-text-muted">Donation</span>
                  </div>
                </div>
              </div>
            </motion.div>

            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.1 }}
              className="bg-surface dark:bg-dark-surface rounded-xl p-4 border border-border dark:border-dark-border shadow-sm"
            >
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-xs font-semibold text-text-muted dark:text-dark-text-muted">Total Spent</h3>
                <button className="text-xs text-primary dark:text-blue-400 flex items-center gap-1 hover:text-primary-dark">
                  All accounts <ChevronDown className="w-3 h-3" />
                </button>
              </div>

              <div className="mb-4">
                <div className="text-xl font-bold text-text dark:text-dark-text mb-3">
                  ${stats.totalSpent.toLocaleString()}
                </div>

                <div className="space-y-2">
                  {stats.categoryPercentages.slice(0, 3).map((item, idx) => (
                    <div key={item.category}>
                      <div className="flex items-center justify-between text-[10px] mb-1">
                        <div className="flex items-center gap-2">
                          <span>{categoryIcons[item.category]}</span>
                          <span className="text-text-muted dark:text-dark-text-muted">{item.category}</span>
                        </div>
                        <span className="font-semibold text-text dark:text-dark-text">
                          {item.percentage.toFixed(1)}%
                        </span>
                      </div>
                      <div className="h-1 bg-surface-alt dark:bg-gray-700 rounded-full overflow-hidden">
                        <div
                          className={`h-full ${categoryColors[item.category]?.bg || 'bg-gray-500'} rounded-full transition-all duration-500`}
                          style={{ width: `${item.percentage}%` }}
                        />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </motion.div>
          </div>

          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.2 }}
            className="bg-surface dark:bg-dark-surface rounded-xl p-4 border border-border dark:border-dark-border shadow-sm"
          >
            <h3 className="text-sm font-semibold text-text dark:text-dark-text mb-4">
              Compare Net Income and Spent
            </h3>

            <div className="flex items-center gap-4 mb-4 text-[10px]">
              <div className="flex items-center gap-2">
                <div className="w-1.5 h-1.5 rounded-full bg-secondary"></div>
                <span className="text-text-muted dark:text-dark-text-muted">Net Income</span>
              </div>
              <div className="flex items-center gap-2">
                <div className="w-1.5 h-1.5 rounded-full bg-warning"></div>
                <span className="text-text-muted dark:text-dark-text-muted">Outcome</span>
              </div>
            </div>

            <div className="relative h-48">
              <div className="absolute inset-0 flex items-end justify-between gap-2 px-4">
                {stats.last7Days.map((day, idx) => {
                  const maxValue = Math.max(...stats.last7Days.map(d => Math.max(d.income, d.expense)), 1)
                  const incomeHeight = (day.income / maxValue) * 100
                  const expenseHeight = (day.expense / maxValue) * 100

                  return (
                    <div key={idx} className="flex-1 flex flex-col items-center gap-2">
                      <div className="w-full flex items-end justify-center gap-1 h-36">
                        <motion.div
                          initial={{ height: 0 }}
                          animate={{ height: `${incomeHeight}%` }}
                          transition={{ delay: 0.3 + idx * 0.1, duration: 0.5 }}
                          className="w-2 bg-gradient-to-t from-secondary to-secondary rounded-t-lg relative group"
                        >
                          <div className="absolute -top-6 left-1/2 -translate-x-1/2 bg-surface-alt dark:bg-dark-surface-alt text-text dark:text-dark-text text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap border border-border dark:border-dark-border">
                            ${day.income}
                          </div>
                        </motion.div>
                        
                        <motion.div
                          initial={{ height: 0 }}
                          animate={{ height: `${expenseHeight}%` }}
                          transition={{ delay: 0.3 + idx * 0.1, duration: 0.5 }}
                          className="w-2 bg-gradient-to-t from-warning to-warning rounded-t-lg relative group"
                        >
                          <div className="absolute -top-6 left-1/2 -translate-x-1/2 bg-surface-alt dark:bg-dark-surface-alt text-text dark:text-dark-text text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap border border-border dark:border-dark-border">
                            ${day.expense}
                          </div>
                        </motion.div>
                      </div>
                      
                      <span className="text-[10px] text-text-muted dark:text-dark-text-muted font-medium">
                        {day.day}
                      </span>
                    </div>
                  )
                })}
              </div>
            </div>
          </motion.div>
        </div>

        <div className="space-y-4">
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.1 }}
          >
            <div className="flex items-center justify-between mb-3">
              <h3 className="text-sm font-semibold text-text dark:text-dark-text">Cards</h3>
              <button className="text-xs text-primary dark:text-blue-400 flex items-center gap-1 hover:text-primary-dark">
                All cards <ChevronDown className="w-3 h-3" />
              </button>
            </div>

            <div className="space-y-3">
              {cards.length > 0 ? (
                cards.slice(0, 2).map((card) => (
                  <div
                    key={card.id}
                    className="relative rounded-xl p-4 text-white overflow-hidden shadow-lg"
                    style={{ backgroundColor: card.color }}
                  >
                    <div className="absolute top-0 right-0 w-24 h-24 bg-white/10 rounded-full -mr-12 -mt-12"></div>
                    <div className="relative z-10">
                      <div className="flex items-start justify-between mb-6">
                        <div>
                          <p className="text-[10px] opacity-80 mb-1">Balance</p>
                          <p className="text-lg font-bold">${card.balance.toLocaleString()}</p>
                        </div>
                        <CreditCard className="w-5 h-5 opacity-80" />
                      </div>
                      
                      <div className="flex items-center justify-between">
                        <button className="text-[10px] bg-white/20 px-3 py-1 rounded-full hover:bg-white/30 transition-colors">
                          See card details
                        </button>
                        <div className="text-[10px] font-semibold uppercase">{card.type}</div>
                      </div>
                    </div>
                  </div>
                ))
              ) : (
                <div className="bg-gradient-to-br from-cyan-400 to-cyan-500 rounded-xl p-4 text-white">
                  <div className="text-center py-4">
                    <CreditCard className="w-10 h-10 mx-auto mb-2 opacity-80" />
                    <p className="text-xs">No cards added yet</p>
                  </div>
                </div>
              )}
            </div>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.2 }}
            className="bg-surface dark:bg-dark-surface rounded-xl p-4 border border-border dark:border-dark-border shadow-sm"
          >
            <h3 className="text-sm font-semibold text-text dark:text-dark-text mb-3">Goals</h3>

            <div className="space-y-3">
              {goals.length > 0 ? (
                goals.map((goal) => {
                  const progress = (goal.current / goal.target) * 100
                  const isCompleted = goal.status === 'completed'
                  
                  return (
                    <div key={goal.id} className="flex items-start gap-2">
                      <div className={`w-4 h-4 rounded-full border-2 flex items-center justify-center flex-shrink-0 mt-0.5 ${
                        isCompleted
                          ? 'bg-secondary border-secondary'
                          : 'border-border dark:border-dark-border bg-surface dark:bg-dark-surface'
                      }`}>
                        {isCompleted && (
                          <svg className="w-2 h-2 text-white" fill="currentColor" viewBox="0 0 20 20">
                            <path fillRule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clipRule="evenodd" />
                          </svg>
                        )}
                      </div>
                      
                      <div className="flex-1">
                        <h4 className="font-semibold text-xs text-text dark:text-dark-text mb-1">
                          {goal.title}
                        </h4>
                        <p className="text-[10px] text-text-muted dark:text-dark-text-muted mb-2">
                          {goal.description}
                        </p>
                        
                        {!isCompleted && (
                          <div className="space-y-1">
                            <div className="flex items-center justify-between text-[10px]">
                              <span className="text-text-muted dark:text-dark-text-muted">
                                ${goal.current.toLocaleString()} / ${goal.target.toLocaleString()}
                              </span>
                              <span className="font-semibold text-text dark:text-dark-text">
                                {progress.toFixed(0)}%
                              </span>
                            </div>
                            <div className="h-1 bg-surface-alt dark:bg-gray-700 rounded-full overflow-hidden">
                              <div
                                className="h-full bg-gradient-to-r from-primary to-primary-light rounded-full transition-all duration-500"
                                style={{ width: `${Math.min(progress, 100)}%` }}
                              />
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  )
                })
              ) : (
                <div className="text-center py-6">
                  <Target className="w-10 h-10 mx-auto mb-2 text-border dark:text-dark-border" />
                  <p className="text-xs text-text-muted dark:text-dark-text-muted">No goals set yet</p>
                </div>
              )}
            </div>
          </motion.div>
        </div>
      </div>
    </div>
  )
}
